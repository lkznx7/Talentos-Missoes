Project talentos_missoes {
  database_type: 'PostgreSQL'
}

// Consolidado - modelo lógico (proposto)
// Validação sugerida em dbdiagram.io

TableGroup identity {
  user
  role
  permission
  user_role
  role_permission
  session
  outbox_event
}

Table identity.user {
  id uuid [pk]
  email varchar(320) [not null, unique]
  password_hash varchar(255) [not null]
  display_name varchar(120) [not null]
  status varchar(20) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table identity.role {
  id uuid [pk]
  code varchar(80) [not null, unique]
  description varchar(255)
}

Table identity.permission {
  id uuid [pk]
  code varchar(120) [not null, unique]
  description varchar(255)
}

Table identity.user_role {
  user_id uuid [not null]
  role_id uuid [not null]
  Indexes {
    (user_id, role_id) [pk]
  }
}

Table identity.role_permission {
  role_id uuid [not null]
  permission_id uuid [not null]
  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table identity.session {
  id uuid [pk]
  user_id uuid [not null]
  refresh_token_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]
  ip_address varchar(64)
  user_agent varchar(500)
}

Table identity.outbox_event {
  id uuid [pk]
  service_name varchar(80) [not null]
  aggregate_type varchar(80) [not null]
  aggregate_id uuid
  event_type varchar(120) [not null]
  schema_version varchar(20) [not null]
  payload jsonb [not null]
  occurred_at timestamptz [not null]
  published_at timestamptz
  status varchar(20) [not null]
  attempts int [not null, default: 0]
  Indexes {
    (status, occurred_at)
  }
}

TableGroup talentos {
  talent
  skill
  experience
  portfolio_item
}

Table talentos.talent {
  id uuid [pk]
  user_id uuid [not null, unique]
  full_name varchar(200) [not null]
  headline varchar(200)
  summary text
  location varchar(200)
  status varchar(20) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table talentos.skill {
  id uuid [pk]
  talent_id uuid [not null]
  name varchar(120) [not null]
  level varchar(30)
  years_experience smallint
  Indexes {
    (talent_id, name) [unique]
  }
}

Table talentos.experience {
  id uuid [pk]
  talent_id uuid [not null]
  company_name varchar(200) [not null]
  title varchar(200) [not null]
  start_date date [not null]
  end_date date
  description text
}

Table talentos.portfolio_item {
  id uuid [pk]
  talent_id uuid [not null]
  title varchar(200) [not null]
  url varchar(2048) [not null]
  description text
  item_type varchar(50)
  created_at timestamptz [not null]
}

TableGroup empresas_missoes {
  company
  company_member
  mission
}

Table empresas_missoes.company {
  id uuid [pk]
  legal_name varchar(255) [not null]
  trade_name varchar(255)
  website varchar(2048)
  status varchar(20) [not null]
  created_by_user_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table empresas_missoes.company_member {
  company_id uuid [not null]
  user_id uuid [not null]
  member_role varchar(40) [not null]
  created_at timestamptz [not null]
  Indexes {
    (company_id, user_id) [pk]
  }
}

Table empresas_missoes.mission {
  id uuid [pk]
  company_id uuid [not null]
  title varchar(200) [not null]
  description text
  status varchar(20) [not null]
  requirements jsonb
  deadline timestamptz
  published_at timestamptz
  closed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null, default: 0]
}

TableGroup candidaturas {
  application
  application_history
}

Table candidaturas.application {
  id uuid [pk]
  mission_id uuid [not null]
  talent_id uuid [not null]
  status varchar(30) [not null]
  eligibility_snapshot jsonb
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null, default: 0]
  Indexes {
    (mission_id, talent_id) [unique]
  }
}

Table candidaturas.application_history {
  id uuid [pk]
  application_id uuid [not null]
  from_state varchar(30)
  to_state varchar(30) [not null]
  changed_by varchar(120) [not null]
  reason varchar(500)
  occurred_at timestamptz [not null]
}

TableGroup notificacoes {
  notification
  notification_attempt
}

Table notificacoes.notification {
  id uuid [pk]
  user_id uuid [not null]
  type varchar(80) [not null]
  title varchar(200) [not null]
  body text [not null]
  status varchar(30) [not null]
  created_at timestamptz [not null]
  read_at timestamptz
}

Table notificacoes.notification_attempt {
  id uuid [pk]
  notification_id uuid [not null]
  attempted_at timestamptz [not null]
  outcome varchar(20) [not null]
  provider_message_id varchar(255)
  failure_reason varchar(500)
}

TableGroup indicadores {
  metric_event
  metric_series
}

Table indicadores.metric_event {
  id uuid [pk]
  event_id uuid [not null, unique]
  event_name varchar(120) [not null]
  aggregate_type varchar(80) [not null]
  aggregate_id uuid [not null]
  occurred_at timestamptz [not null]
  dimensions jsonb
}

Table indicadores.metric_series {
  metric_name varchar(120) [not null]
  granularity varchar(20) [not null]
  bucket_start timestamptz [not null]
  value numeric(20,6) [not null]
  updated_at timestamptz [not null]
  Indexes {
    (metric_name, granularity, bucket_start) [pk]
  }
}

TableGroup comunicacao {
  conversation
  message
}

Table comunicacao.conversation {
  id uuid [pk]
  company_id uuid [not null]
  talent_id uuid [not null]
  mission_id uuid
  created_at timestamptz [not null]
}

Table comunicacao.message {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_user_id uuid [not null]
  content_type varchar(40) [not null]
  content text [not null]
  sent_at timestamptz [not null]
  delivered_at timestamptz
  read_at timestamptz
}

TableGroup integracoes {
  external_event
  webhook_delivery
}

Table integracoes.external_event {
  id uuid [pk]
  source varchar(80) [not null]
  external_event_id varchar(255) [not null]
  dedup_key varchar(500) [not null, unique]
  received_at timestamptz [not null]
  status varchar(30) [not null]
  payload_ref varchar(500) [not null]
  attempt_count int [not null, default: 0]
  processed_at timestamptz
  failure_reason varchar(500)
  Indexes {
    (source, external_event_id)
  }
}

Table integracoes.webhook_delivery {
  id uuid [pk]
  target varchar(2048) [not null]
  event_ref varchar(255) [not null]
  status varchar(30) [not null]
  attempts int [not null, default: 0]
  last_attempt_at timestamptz
  next_retry_at timestamptz
}

// Intra-schema relationships with physical foreign keys.
Ref: identity.user_role.user_id > identity.user.id
Ref: identity.user_role.role_id > identity.role.id
Ref: identity.role_permission.role_id > identity.role.id
Ref: identity.role_permission.permission_id > identity.permission.id
Ref: identity.session.user_id > identity.user.id

Ref: talentos.skill.talent_id > talentos.talent.id
Ref: talentos.experience.talent_id > talentos.talent.id
Ref: talentos.portfolio_item.talent_id > talentos.talent.id

Ref: empresas_missoes.company_member.company_id > empresas_missoes.company.id
Ref: empresas_missoes.mission.company_id > empresas_missoes.company.id

Ref: candidaturas.application_history.application_id > candidaturas.application.id
Ref: notificacoes.notification_attempt.notification_id > notificacoes.notification.id
Ref: comunicacao.message.conversation_id > comunicacao.conversation.id

// Cross-service links are correlated IDs without physical foreign keys, per logical model.
// talentos.talent.user_id -> identity.user.id (unique)
// empresas_missoes.company.created_by_user_id -> identity.user.id (opcional)
// empresas_missoes.company_member.user_id -> identity.user.id
// candidaturas.application.mission_id -> empresas_missoes.mission.id
// candidaturas.application.talent_id -> talentos.talent.id
// notificacoes.notification.user_id -> identity.user.id
// comunicacao.conversation.company_id -> empresas_missoes.company.id
// comunicacao.conversation.talent_id -> talentos.talent.id
// comunicacao.conversation.mission_id -> empresas_missoes.mission.id (opcional)
// comunicacao.message.sender_user_id -> identity.user.id
// Outbox: the logical model mentions identity.outbox_event and shared.outbox_event;
// ownership/schema is pending; DBML preserves identity.outbox_event for now.


// Shared idempotency infrastructure; physical deployment scope may vary by consumer.
TableGroup shared {
  processed_event
}

Table shared.processed_event {
  consumer_name varchar(120) [not null]
  event_id uuid [not null]
  processed_at timestamptz [not null]
  Indexes {
    (consumer_name, event_id) [pk]
  }
}
