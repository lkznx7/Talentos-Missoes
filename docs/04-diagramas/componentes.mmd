C4Component
title Talentos & Missões - Componentes (Monólito Modular)

Container_Boundary(api, "API Principal") {
  Component(s1, "S1 Talentos", "Módulo", "perfis/habilidades")
  Component(s2, "S2 Empresas/Missões", "Módulo", "empresa/missão")
  Component(s3, "S3 Candidaturas", "Módulo", "candidatura, estado")
  Component(s5, "S5 Indicadores", "Módulo", "métricas")
  Component(s6, "S6 Comunicação", "Módulo", "chat (pendente)")
  Component(s7, "S7 Identidade", "Módulo", "auth/authz")
  Component(s8, "S8 Integrações", "Módulo", "webhooks")
  Component(outbox, "Outbox Relay", "Processo interno", "publica eventos")
}
Container(worker4, "Worker S4", "Processo")
ContainerDb(db, "DB", "Relacional")
Container(broker, "Broker", "Eventos")
Rel(s3, s1, "consulta/valida", "in-process")
Rel(s3, s2, "consulta/valida", "in-process")
Rel(s3, s7, "autoriza", "in-process")
Rel(s3, outbox, "escreve", "mesma TX")
Rel(outbox, broker, "publica", "at-least-once")
